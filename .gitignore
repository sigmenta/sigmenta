# =============================================================================
# Women's Favorite — .gitignore
# Vite + React + TypeScript + Firebase + Cloudinary

# Dependencies
node_modules/
functions/node_modules/
# Build output
dist/
functions/lib/
# Vite cache
.vite/
vite.config.ts.timestamp-*
# Environment variables — NEVER commit real .env files
.env
.env.local
.env.*.local
# .env.example is intentionally NOT ignored so teammates can bootstrap quickly
# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
# TypeScript
*.tsbuildinfo
# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# Test / Coverage
coverage/
.nyc_output/
# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
# Misc
*.pem
*.key
.env.*
!.env.example
