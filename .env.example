# =============================================================================
# Women's Favorite — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# All VITE_* variables are bundled into the client-side build — keep secrets out!
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — Frontend SDK (safe to be public, protected by Firebase Security Rules)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=1:your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Cloudinary — Frontend (unsigned upload preset only — NO API secret here!)
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# Use a RESTRICTED / unsigned upload preset scoped to the product-images folder
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ⚠️  SECURITY WARNING ⚠️
# CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET are BACKEND secrets.
# They MUST be set ONLY in Firebase Functions environment config:
#   firebase functions:config:set cloudinary.api_key="xxx" cloudinary.api_secret="yyy"
# NEVER prefix them with VITE_ — doing so exposes them in the client bundle!

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
# Options: development | production
VITE_APP_ENV=development
